{
  "name": "25-and-school-game",
  "private": true,
  "version": "0.1.0",
  "description": "剧情向 2D 恐怖解谜同人游戏（非商业）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.18.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "local.fan.twenty-five-and-school",
    "productName": "25-and-school",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
